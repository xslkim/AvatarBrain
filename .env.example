# LLM 模式（openai / local）
LLM_PROVIDER=local

# 本地模型（LLM_PROVIDER=local 时必填）
LLM_LOCAL_MODEL_PATH=/home/ubuntu/models/Qwen/Qwen3-0___6B
LLM_DEVICE=cpu

# 线上模型（LLM_PROVIDER=openai 或运行时切换到 openai 时必填）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# LLM 参数（可选）
LLM_TIMEOUT=20
LLM_MAX_TOKENS=96
LLM_TEMPERATURE=0.3
LLM_SYSTEM_PROMPT=你是一个自然、友好的中文语音助手。

# 服务监听（可选）
HTTP_HOST=0.0.0.0
HTTP_PORT=8019

# HTTPS（可选，跨机器访问时需要）
# SSL_CERTFILE=certs/dev-cert.pem
# SSL_KEYFILE=certs/dev-key.pem
